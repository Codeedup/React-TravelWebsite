---
import Header from "../components/Header.jsx";
import HeroFilters from "../components/HeroFilters.jsx";
import CityCard from "../components/CityCard.jsx";
import FeatureStrip from "../components/FeatureStrip.jsx";
import "../styles/global.css";

// Placeholder city data stays local for now so the page is fully static.
const cities = [
  {
    name: "Lisbon",
    country: "Portugal",
    imageClass: "lisbon",
    stats: {
      Cost: "Moderate",
      Vibe: "Relaxed",
      Language: "Portuguese",
      Weather: "Mild, Sunny",
    },
  },
  {
    name: "Tokyo",
    country: "Japan",
    imageClass: "tokyo",
    stats: {
      Cost: "High",
      Vibe: "Energetic",
      Language: "Japanese",
      Weather: "Four Seasons",
    },
  },
  {
    name: "Prague",
    country: "Czechia",
    imageClass: "prague",
    stats: {
      Cost: "Low",
      Vibe: "Historic",
      Language: "Czech",
      Weather: "Mild, Cloudy",
    },
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="City Vibe Explorer is a static travel comparison homepage prototype."
    />
    <title>City Vibe Explorer</title>
  </head>
  <body>
    <Header client:load />

    <main class="page-shell">
      <section class="hero-banner" aria-labelledby="hero-title">
        <div class="sun-shape" aria-hidden="true"></div>
        <div class="cloud cloud-left" aria-hidden="true"></div>
        <div class="cloud cloud-right" aria-hidden="true"></div>
        <div class="palm-shape palm-large" aria-hidden="true"></div>
        <div class="palm-shape palm-small" aria-hidden="true"></div>
        <div class="coast-shape" aria-hidden="true"></div>
        <div class="city-shape city-left" aria-hidden="true"></div>
        <div class="city-shape city-right" aria-hidden="true"></div>

        <div class="hero-content">
          <h1 id="hero-title">Find a city that fits you</h1>
          <p>
            Compare destinations by cost, vibe, language, weather, and region
            to discover the best place for your next adventure.
          </p>
        </div>

        <HeroFilters client:load />
      </section>

      <section class="city-preview-grid" aria-label="Featured city previews">
        {cities.map((city) => <CityCard city={city} />)}
      </section>

      <FeatureStrip />
    </main>
  </body>
</html>
