---
import Header from "../components/Header.jsx";
import SearchContainer from "../components/SearchContainer.jsx";
import FeatureStrip from "../components/FeatureStrip.jsx";
import "../styles/global.css";
---

<html lang="en">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="City Vibe Explorer is a live SQLite database relational search prototype ecosystem."
    />
    <title>City Vibe Explorer</title>
  </head>

  <body>

    <Header currentPage="Home" client:load />

    <main class="page-shell">
      
      <section class="hero-section" aria-labelledby="hero-title">

        <div class="hero-copy">
          <h1 id="hero-title">Find your next city match</h1>
          <p>
            Search by activities to find your next holiday!
          </p>
        </div>

        {/* This combined wrapper component handles live search events in-place without page routing */}
        <SearchContainer client:load />
      </section>

      <FeatureStrip />

    </main>

  </body>
</html>