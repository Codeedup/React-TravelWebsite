---
import Header from "../components/Header.jsx";
import DatabaseViewer from "../components/DatabaseViewer.jsx";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Database Viewer | City Vibe Explorer</title>
  </head>
  <body>
    <Header currentPage="Data Sources" client:load />

    <main class="page-shell" style={{ paddingTop: "4rem" }}>
      <section style={{ textAlign: "center", marginBottom: "2rem" }}>
        <h1>Live Database Inspector</h1>
        <p>Viewing real-time data directly from SQLite.</p>
      </section>

      {/* Render our new component! */}
      <DatabaseViewer client:load />
    </main>
  </body>
</html>