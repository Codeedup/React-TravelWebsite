---
import Header from "../components/Header.jsx";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="About City Vibe Explorer and its open source travel recommendation data."
    />
    <title>About | City Vibe Explorer</title>
  </head>
  <body>
    <Header currentPage="About" client:load />

    <main class="page-shell about-shell">
      <section class="about-panel" aria-labelledby="about-title">
        <p class="about-kicker">About</p>
        <h1 id="about-title">City Vibe Explorer</h1>
        <p>
          We are _____ we use open source data to create the best
          recommendations for your travel. The goal isn't to sell you a
          vacation but to inspire travel and broaden the possible destinations
          you would consider. We take no responsibility for bad vacations.
        </p>
      </section>
    </main>
  </body>
</html>
