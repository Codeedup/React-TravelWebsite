---
import FooterTicker from "../components/FooterTicker.jsx";
import Header from "../components/Header.jsx";
import LeftSidebar from "../components/LeftSidebar.jsx";
import RightSidebar from "../components/RightSidebar.jsx";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="About DREAMROUTE, a messy MySpace-inspired travel recommender powered by a Flask API."
    />
    <title>About | DREAMROUTE_</title>
  </head>
  <body>
    <div class="page-noise" aria-hidden="true"></div>
    <Header currentPath="/about" client:load />
    <main class="myspace-shell info-shell">
      <LeftSidebar />

      <section class="main-column info-column" aria-label="About Dreamroute">
        <section class="results-hero panel info-hero" aria-labelledby="about-title">
          <p>\ ABOUT DREAMROUTE</p>
          <h1 id="about-title">Travel suggestions with Astronomical accuracy</h1>
          <span>Flask API data, SQLite tables, and one very online interface.</span>
        </section>

        <section class="results-panel panel info-panel" aria-labelledby="about-project-title">
          <div class="section-title-row">
            <div>
              <p>\ PROJECT FILE</p>

            </div>
            <a href="/">back home &gt;&gt;</a>
          </div>

          <div class="info-copy">
            <p>
              DREAMROUTE matches destinations by month, budget, weather, activity, and travel vibe. The
              frontend lives in Astro and React, while the recommender data comes from the local
              Flask API backed by the SQLite travel database.
            </p>
            <p>
              The visual style is intetionally chaotic because your travel doesn't have to be
            </p>
            <p><a href="https://git.arts.ac.uk/n-ghinea0920251/DREAMROUTE_">GitHub Link</a></p>
          </div>

          <dl class="info-facts">
            <div>
              <dt>frontend</dt>
              <dd>Astro + React</dd>
            </div>
            <div>
              <dt>api</dt>
              <dd>Flask on port 5001</dd>
            </div>
            <div>
              <dt>database</dt>
              <dd>SQLite travel_planner.db</dd>
            </div>
          </dl>
        </section>
      </section>

      <RightSidebar />
    </main>
    <FooterTicker />
  </body>
</html>
