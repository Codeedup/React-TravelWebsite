---
import Header from "../components/Header.jsx";
import BottomTicker from "../components/BottomTicker.jsx";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="About the WAYFINDER travel recommender prototype."
    />
    <title>About | WAYFINDER</title>
  </head>
  <body>
    <Header currentPage="About" client:load />
    <main class="about-shell">
      <section class="about-panel hud-panel" aria-labelledby="about-title">
        <p class="kicker">// Research note</p>
        <h1 id="about-title">WAYFINDER travel lab</h1>
        <p>
          WAYFINDER translates destination data into readable travel matches.
          This prototype keeps the existing Flask API connected while testing a
          darker, more technical dashboard interface for discovery.
        </p>
        <div class="about-grid" aria-label="Prototype capabilities">
          <span>Live filter options</span>
          <span>Backend ranked results</span>
          <span>Responsive HUD layout</span>
        </div>
      </section>
    </main>
    <BottomTicker />
  </body>
</html>
